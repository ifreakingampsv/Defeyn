# Frontend environment
# Copy to .env.local and adjust as needed.

# Base URL of the AI Tutor backend (REST + SSE).
# When set, getTutorApi() logs a note; wire the real client in
# app/src/services/api/index.ts (see BACKEND.md). Leave unset to run fully
# offline on the in-memory mock (current default).
VITE_API_BASE_URL=

# Force the mock API even when a base URL is present (useful for UI dev).
VITE_USE_MOCK_API=true
