# Defeyn server configuration — copy to .env and adjust.

# HTTP port the server listens on.
PORT=8787

# SQLite database file (created automatically). V2 uses its own per-object
# store file; the v1 file (defeyn.db) is never written again and stays on
# disk as a readable archive (ADR-0001).
DB_PATH=./defeyn-v2.db

# SSE keepalive ping interval (ms) while a turn generates; 0 disables.
# Long LLM turns are silent between blocks; proxies and idle-timeouts kill
# quiet connections. The ping keeps them open (turns queue per session and
# complete even if a client disconnects — refresh recovers).
KEEPALIVE_MS=15000

# LLM provider: "auto" (default) detects in this order:
#   openai -> anthropic -> ollama -> local (rule-based engine, always available)
# or force one: "openai" | "anthropic" | "ollama" | "local"
LLM_PROVIDER=auto

# OpenAI (optional) — enables real AI generation + streaming.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Quick model (optional) — the second, hybrid-ready LLM slot. Deliberately
# unpopulated in v2.0: leave QUICK_OPENAI_API_KEY empty and everything runs
# on the main provider above. Set it to route interactive moments (short
# replies, card edits) to a fast non-thinking model.
QUICK_OPENAI_API_KEY=
QUICK_OPENAI_MODEL=
QUICK_OPENAI_BASE_URL=

# Anthropic (optional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama (optional) — fully local AI, no API key needed.
# Install https://ollama.com then: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
